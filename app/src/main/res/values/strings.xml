<?xml version="1.0" encoding="utf-8"?>
<!--
  Every line the app says itself, so it can speak the phone's language
  (ru, he, uk alongside this one).

  What is deliberately *not* here: everything the core generates — the status
  line after a press, the section titles, control labels and descriptions in
  ⚙ Settings, the built-in points' names. Those come from the schema dumped
  from the web app, they are the same words in both apps, and translating
  them would mean translating the web app.
-->
<resources>
    <string name="app_name" translatable="false">Synesthesia</string>

    <!-- The notification, which is also what a watch or a car shows. -->
